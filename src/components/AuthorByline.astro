---
import { SITE } from '../config';

interface Props {
  updated: Date;
}

const { updated } = Astro.props;

function initials(name: string): string {
  return name.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]?.toUpperCase()).join('');
}

const updatedIso = updated.toISOString().slice(0, 10);
const updatedLabel = updated.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
---

<div class="expert-strip" style="max-width:1080px; margin:0 auto 8px; padding:0 28px 44px; display:flex; gap:18px; align-items:center; justify-content:center">
  <div
    aria-hidden="true"
    style="width:52px; height:52px; border-radius:50%; border:3px solid var(--paper); background:linear-gradient(160deg,#1f2b3a,#101822); display:flex; align-items:center; justify-content:center; color:#fff; font-family:var(--serif); font-weight:700; font-size:15px; flex:0 0 auto"
  >
    {initials(SITE.authorName)}
  </div>
  <div style="max-width:52ch; text-align:left">
    <div style="font-size:13px; color:var(--ink-soft)">
      Written and ranked by <b style="color:var(--ink)">{SITE.authorName}</b>, {SITE.authorRole}
    </div>
    <div style="font-size:12.5px; color:var(--ink-soft); margin-top:3px">
      Every title read in full before ranking. <a href="/about" style="color:var(--accent); font-weight:600">How we choose books →</a>
    </div>
    <div style="font-size:11.5px; color:var(--ink-soft); margin-top:3px">
      Last updated <time datetime={updatedIso}>{updatedLabel}</time>
    </div>
  </div>
</div>

<hr style="border:none; border-top:1px solid var(--line); max-width:1080px; margin:0 auto" />
