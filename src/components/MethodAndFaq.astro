---
interface Props {
  methodTitle: string;
  methodBody: string;
  faq: { q: string; a: string }[];
}

const { methodTitle, methodBody, faq } = Astro.props;
---

<section style="max-width:900px; margin:0 auto; padding:52px 28px 0">
  <div class="kicker" style="margin-bottom:10px">How this list was made</div>
  <h2 style="font-family:var(--serif); font-size:24px; font-weight:400; margin-bottom:14px">{methodTitle}</h2>
  <p style="font-size:14.5px; color:var(--ink-soft); max-width:66ch">{methodBody}</p>

  <div class="faq-grid" style="margin-top:36px; display:grid; grid-template-columns:1fr 1fr; gap:30px 40px">
    {faq.map((f) => (
      <div style="border-top:1px solid var(--line); padding-top:18px">
        <h3 style="font-family:var(--serif); font-size:17px; font-weight:400; line-height:1.35; margin-bottom:8px">{f.q}</h3>
        <p style="font-size:13.5px; color:var(--ink-soft)">{f.a}</p>
      </div>
    ))}
  </div>
</section>
