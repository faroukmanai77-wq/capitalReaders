---
import { SITE } from '../config';
---

<div style="background:var(--accent-soft); padding:52px 28px; text-align:center">
  <div style="max-width:560px; margin:0 auto">
    <h2 style="font-family:var(--serif); font-size:23px; font-weight:400; margin-bottom:10px">One list. One book. Every two weeks.</h2>
    <p style="font-size:13.5px; color:var(--ink-soft); margin-bottom:22px">A short, opinionated email — no filler, no fifty-book roundups. Just what's worth reading next.</p>
    <form
      style="display:flex; gap:8px; justify-content:center; flex-wrap:wrap"
      action={`https://buttondown.com/api/emails/embed-subscribe/${SITE.buttondownUsername}`}
      method="post"
    >
      <label for="cr-email" class="visually-hidden">Email address</label>
      <input
        id="cr-email"
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder="you@email.com"
        style="padding:11px 15px; border:1px solid var(--line); border-radius:2px; width:260px; font-size:13.5px; background:#fff; color:var(--ink)"
      />
      <input type="hidden" name="embed" value="1" />
      <button type="submit" class="newsletter-btn" style="background:var(--ink); color:#fff; border:none; padding:11px 20px; border-radius:2px; font-size:12px; text-transform:uppercase; letter-spacing:.04em; font-weight:700; cursor:pointer; transition:background-color .15s ease">
        Subscribe
      </button>
    </form>
    <div style="font-size:11px; color:var(--ink-soft); margin-top:14px">
      As an Amazon Associate and Bookshop.org affiliate, we earn from qualifying purchases.
    </div>
  </div>
</div>

<style>
  .newsletter-btn:hover {
    background: var(--accent) !important;
  }
</style>
