---
interface RelatedItem {
  kicker: string;
  cardTitle: string;
  cardSummary: string;
  href: string;
}

interface Props {
  lists: RelatedItem[];
  heading?: string;
  viewAllHref?: string;
  viewAllLabel?: string;
}

const { lists, heading = 'More Reading Lists', viewAllHref = '/', viewAllLabel = 'View All Lists →' } = Astro.props;
---

<section style="max-width:1080px; margin:0 auto; padding:56px 28px">
  <div style="display:flex; justify-content:space-between; align-items:baseline; gap:20px; margin-bottom:28px">
    <h2 style="font-family:var(--serif); font-size:24px; font-weight:400">{heading}</h2>
    <a href={viewAllHref} style="font-size:12px; text-transform:uppercase; letter-spacing:.05em; color:var(--accent); font-weight:700; white-space:nowrap">{viewAllLabel}</a>
  </div>
  <div class="related-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:30px">
    {lists.map((item) => (
      <a href={item.href} style="padding-top:16px; border-top:2px solid var(--ink); display:block">
        <div class="kicker" style="margin-bottom:10px">{item.kicker}</div>
        <h3 style="font-family:var(--serif); font-size:17px; font-weight:400; line-height:1.35; margin-bottom:8px">{item.cardTitle}</h3>
        <p style="font-size:13px; color:var(--ink-soft)">{item.cardSummary}</p>
      </a>
    ))}
  </div>
</section>
