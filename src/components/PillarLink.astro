---
interface Props {
  hubTitle: string;
  hubHref: string;
}

const { hubTitle, hubHref } = Astro.props;
---

<div style="max-width:1080px; margin:0 auto; padding:16px 28px 0; font-size:12.5px; color:var(--ink-soft)">
  Part of <a href={hubHref} style="color:var(--accent); font-weight:600">{hubTitle} →</a>
</div>
