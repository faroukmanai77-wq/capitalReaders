---
interface Section {
  heading: string;
  body: string;
}

interface Props {
  kicker: string;
  title: string;
  standfirst: string;
  updated: string;
  sections: Section[];
}

const { kicker, title, standfirst, updated, sections } = Astro.props;
---

<main style="max-width:720px; margin:0 auto; padding:56px 28px 20px">
  <div class="kicker">{kicker}</div>
  <h1 style="font-family:var(--serif); font-size:34px; line-height:1.25; font-weight:400; margin-bottom:18px">{title}</h1>
  <p style="font-size:16px; color:var(--ink-soft)">{standfirst}</p>
  <div style="margin-top:20px; font-size:11.5px; color:var(--ink-soft)">Last updated {updated}</div>

  {sections.map((s) => (
    <section style="margin-top:38px; border-top:1px solid var(--line); padding-top:22px">
      <h2 style="font-family:var(--serif); font-size:20px; font-weight:400; margin-bottom:10px">{s.heading}</h2>
      <p style="font-size:14px; color:var(--ink-soft)">{s.body}</p>
    </section>
  ))}
  <div style="margin-top:52px"></div>
</main>
