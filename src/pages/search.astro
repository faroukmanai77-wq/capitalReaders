---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import { amazonUrl, bookshopUrl, gradientFor, rankLabel } from '../lib/affiliate';

const lists = await getCollection('lists');

const allBooks = lists.flatMap((list) =>
  list.data.books
    .slice()
    .sort((a, b) => a.rank - b.rank)
    .map((book, i) => ({
      title: book.title,
      author: book.author,
      published: book.published,
      keyIdea: book.keyIdea,
      bestFor: book.bestFor,
      blurb: book.blurb,
      category: list.data.category,
      categoryHref: `/${list.data.path}`,
      rankLabel: rankLabel(i),
      gradient: gradientFor(i),
      amazonUrl: amazonUrl(book.title, book.author, book.amazonUrl),
      coverImageUrl: book.coverImageUrl,
    }))
);
---

<BaseLayout title="Search the library" description="Search every book ranked on this site by title, author, or idea." noindex currentPath="/search">
  <main style="max-width:900px; margin:0 auto; padding:56px 28px 20px">
    <div class="kicker">Search</div>
    <h1 style="font-family:var(--serif); font-size:34px; line-height:1.25; font-weight:400; margin-bottom:18px">Search the library</h1>
    <p style="font-size:16px; color:var(--ink-soft); max-width:56ch">
      Every book we have ranked, searchable by title, author, or idea. {allBooks.length} titles across {lists.length} lists.
    </p>

    <div style="margin-top:26px; border-top:1px solid var(--line); border-bottom:1px solid var(--line); padding:22px 0">
      <label for="cr-search" style="display:block; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.1em; color:var(--accent); margin-bottom:10px">
        Title, author, or idea
      </label>
      <input
        id="cr-search"
        type="search"
        placeholder="index funds, Graham, debt payoff…"
        autocomplete="off"
        style="width:100%; padding:13px 15px; border:1px solid var(--line); border-radius:2px; background:#fff; color:var(--ink); font-size:15px"
      />
      <div id="cr-result-summary" aria-live="polite" style="font-size:12px; color:var(--ink-soft); margin-top:12px">
        Showing all {allBooks.length} books. Start typing to narrow the list.
      </div>
    </div>

    <div id="cr-results" style="margin-top:8px">
      {allBooks.map((book) => (
        <article
          class="cr-result"
          data-haystack={`${book.title} ${book.author} ${book.keyIdea} ${book.bestFor} ${book.blurb} ${book.category}`.toLowerCase()}
          style="display:grid; grid-template-columns:76px minmax(0,1fr); gap:22px; padding:26px 0; border-bottom:1px solid var(--line); align-items:start"
        >
          {book.coverImageUrl ? (
            <img
              src={book.coverImageUrl}
              alt={`Cover of ${book.title} by ${book.author}`}
              width="76"
              height="111"
              loading="lazy"
              decoding="async"
              style="width:76px; height:111px; border-radius:2px; box-shadow:0 8px 18px -10px rgba(26,26,24,.35); object-fit:cover; display:block"
            />
          ) : (
            <div
              role="img"
              aria-label={`Cover of ${book.title} by ${book.author}`}
              style={`width:76px; height:111px; border-radius:2px; box-shadow:0 8px 18px -10px rgba(26,26,24,.35); display:flex; align-items:flex-end; padding:9px 8px; color:#fff; background:${book.gradient}; font-family:var(--serif); font-size:10px; line-height:1.25; font-weight:700`}
            >
              {book.title}
            </div>
          )}
          <div>
            <a href={book.categoryHref} style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.1em; color:var(--accent)">{book.category}</a>
            <h2 style="font-family:var(--serif); font-size:19px; font-weight:400; margin:6px 0 4px">{book.title}</h2>
            <div style="font-size:12.5px; color:var(--ink-soft); letter-spacing:.02em">
              by {book.author} · {book.published} · ranked {book.rankLabel} in {book.category}
            </div>
            <p style="font-size:13.5px; color:var(--ink-soft); margin-top:10px; max-width:60ch">{book.keyIdea}</p>
            <div style="display:flex; align-items:center; gap:14px; flex-wrap:wrap; margin-top:14px">
              <a href={book.amazonUrl} target="_blank" rel="sponsored noopener" class="buy-btn" style="font-size:11px; padding:8px 15px">Buy on Amazon</a>
              <a href={book.categoryHref} style="font-size:11.5px; color:var(--ink-soft)">See the full list →</a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <p id="cr-empty" style="display:none; padding:44px 0 12px; text-align:center">
      <span style="display:block; font-family:var(--serif); font-size:20px; font-weight:400; font-style:italic; color:var(--ink)" id="cr-empty-text"></span>
      <span style="display:block; font-size:13.5px; color:var(--ink-soft); margin-top:10px">Try an author's surname, or browse the four lists from the menu above.</span>
    </p>

    <div style="margin-top:48px"></div>
  </main>
</BaseLayout>

<script>
  const input = document.getElementById('cr-search') as HTMLInputElement;
  const results = Array.from(document.querySelectorAll<HTMLElement>('.cr-result'));
  const summary = document.getElementById('cr-result-summary')!;
  const empty = document.getElementById('cr-empty')!;
  const emptyText = document.getElementById('cr-empty-text')!;
  const total = results.length;

  function runSearch() {
    const term = input.value.trim().toLowerCase();
    let visible = 0;
    for (const el of results) {
      const match = !term || (el.dataset.haystack ?? '').includes(term);
      el.style.display = match ? '' : 'none';
      if (match) visible += 1;
    }
    if (!term) {
      summary.textContent = `Showing all ${total} books. Start typing to narrow the list.`;
    } else {
      summary.textContent = visible === 1 ? `1 book matches “${term}”` : `${visible} books match “${term}”`;
    }
    empty.style.display = visible === 0 ? 'block' : 'none';
    if (visible === 0) emptyText.textContent = `Nothing here matches “${term}”.`;
  }

  input.addEventListener('input', () => {
    const url = new URL(window.location.href);
    if (input.value) url.searchParams.set('q', input.value);
    else url.searchParams.delete('q');
    window.history.replaceState({}, '', url);
    runSearch();
  });

  const initialQuery = new URLSearchParams(window.location.search).get('q');
  if (initialQuery) input.value = initialQuery;
  runSearch();
</script>
